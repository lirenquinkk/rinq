{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "installCommand": "",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self' https://yt3.ggpht.com https://i.ytimg.com; connect-src https://psesapmlbjukmdnxkcrv.supabase.co; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/studio/tiktok",
      "destination": "/studio-tiktok.html"
    },
    {
      "source": "/ru/studio/tiktok",
      "destination": "/ru/studio-tiktok.html"
    },
    {
      "source": "/uk/studio/tiktok",
      "destination": "/uk/studio-tiktok.html"
    }
  ]
}
